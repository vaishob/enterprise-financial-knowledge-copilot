# Synthetic-data demonstration only. Never commit a populated .env.
APP_ENV=demo
DEMO_AUTH_ENABLED=true
AUTO_INGEST=true
# Omit DATABASE_URL for the repository-relative SQLite database.
# DATABASE_URL=postgresql+psycopg://copilot:local-demo-only@localhost:5432/copilot
POSTGRES_PASSWORD=local-demo-only
LLM_PROVIDER=local
LLM_MODEL=extractive-v1
LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-bow-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
# AWS_PROFILE=
# BEDROCK_MODEL_ID=
CHUNK_STRATEGY=recursive
CHUNK_SIZE=180
CHUNK_OVERLAP=30
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.16
HYBRID_WEIGHT=0.45
ENABLE_RERANKING=true
QUERY_REWRITE_ENABLED=true
MAX_CONTEXT_TOKENS=1800
MAX_COMPLETION_TOKENS=700
TEMPERATURE=0
PROVIDER_TIMEOUT_SECONDS=30
# Configure actual contracted prices when using a paid provider. Zero means unpriced.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
PROMPT_VERSION=financial-grounding-v1.0
TELEMETRY_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318/v1/traces
# For production: disable demo authentication and auto-ingestion; set a random >=32-character secret.
# AUTH_TOKEN_SECRET=
AUTH_ISSUER=financial-copilot
AUTH_AUDIENCE=financial-copilot-api
DEEPEVAL_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
BACKEND_URL=http://127.0.0.1:8000

