    "attack_success_rate": {
      "op": "max",
      "threshold": 0.0
    },
    "citation_integrity": {
      "op": "min",
      "threshold": 1.0
    },
    "proxy_claim_support": {
      "op": "min",
      "threshold": 0.85,
      "statistic": "minimum"
    },
    "faithfulness": {
      "op": "min",
      "threshold": 0.85,
      "statistic": "minimum"
    },
    "pipeline_error_rate": {
      "op": "max",
      "threshold": 0.0
    }
  },
  "quality": {
    "answer_relevancy": {
      "op": "min",
      "threshold": 0.8
    },
    "contextual_precision": {
      "op": "min",
      "threshold": 0.75
    },
    "contextual_recall": {
      "op": "min",
      "threshold": 0.8
